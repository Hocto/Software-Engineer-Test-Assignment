<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tuum.banking.repository.BalanceMapper">

    <resultMap id="balanceResultMap" type="com.tuum.banking.model.entity.Balance">
        <id property="id" column="id"/>
        <result property="accountId" column="account_id"/>
        <result property="currency" column="currency"/>
        <result property="availableAmount" column="available_amount"/>
        <result property="version" column="version"/>
    </resultMap>

    <!--
      One multi-row INSERT rather than one statement per currency. Opening an account with
      four currencies is a single round trip instead of four; generated ids are written back
      onto the list elements, which the ACCOUNT_CREATED event needs.
    -->
    <insert id="insertAll" useGeneratedKeys="true" keyProperty="balances.id">
        INSERT INTO balance (account_id, currency, available_amount)
        VALUES
        <foreach collection="balances" item="balance" separator=",">
            (#{balance.accountId}, #{balance.currency}, #{balance.availableAmount})
        </foreach>
    </insert>

    <select id="findByAccountId" resultMap="balanceResultMap">
        SELECT id, account_id, currency, available_amount, version
        FROM balance
        WHERE account_id = #{accountId}
        ORDER BY currency
    </select>

    <!--
      Pessimistic row lock. Concurrent transactions against the same (account, currency)
      queue here until the holder commits or rolls back, which is what makes the
      read-modify-write of available_amount safe without a retry loop.
    -->
    <select id="findByAccountIdAndCurrencyForUpdate" resultMap="balanceResultMap">
        SELECT id, account_id, currency, available_amount, version
        FROM balance
        WHERE account_id = #{accountId}
          AND currency = #{currency}
        FOR UPDATE
    </select>

    <update id="updateAmount">
        UPDATE balance
        SET available_amount = #{availableAmount},
            version          = version + 1,
            updated_at       = now()
        WHERE id = #{id}
    </update>

</mapper>
