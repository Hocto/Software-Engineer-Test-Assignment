<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tuum.banking.repository.AccountMapper">

    <resultMap id="accountResultMap" type="com.tuum.banking.model.entity.Account">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="country" column="country"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.tuum.banking.model.entity.Account"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO account (customer_id, country)
        VALUES (#{customerId}, #{country})
    </insert>

    <select id="findById" resultMap="accountResultMap">
        SELECT id, customer_id, country, created_at
        FROM account
        WHERE id = #{id}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM account WHERE id = #{id})
    </select>

</mapper>
